{
  "name": "@noema/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/ensure-next-middleware-manifest.cjs && next dev --port 3000",
    "build": "next build",
    "start": "node ../../scripts/ensure-next-middleware-manifest.cjs && next start",
    "lint": "eslint --config ../../eslint.config.mjs \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --config ../../eslint.config.mjs \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@noema/api-client": "workspace:*",
    "@noema/auth": "workspace:*",
    "@noema/contracts": "workspace:*",
    "@noema/graph": "workspace:*",
    "@noema/types": "workspace:*",
    "@noema/ui": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.2",
    "@tanstack/react-query": "^5.60.0",
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.460.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph": "^1.48.2",
    "react-hook-form": "^7.53.2",
    "react-simple-maps": "^3.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@types/d3-geo": "^3.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
