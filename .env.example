# =============================================================================
# Noema Environment Configuration
# =============================================================================

# Pedagogy Guardian service (realignment Batch 8)
PEDAGOGY_GUARDIAN_ENABLED=false
PEDAGOGY_GUARDIAN_SERVICE_URL=http://localhost:3016
PEDAGOGY_GUARDIAN_SERVICE_TOKEN=
CONTENT_AGENT_ENABLED=false
CONTENT_AGENT_SERVICE_URL=http://localhost:8011
CONTENT_AGENT_SERVICE_TOKEN=
CONSUMER_STREAM_METACOGNITION_SERVICE=noema:events:metacognition-service
EVENT_STREAM_CONTENT=noema:events:content-service
EVENT_STREAM_METACOGNITION=noema:events:metacognition-service
EVENT_STREAM_SCHEDULER=noema:events:scheduler-service
EVENT_STREAM_SESSION=noema:events:session-service
EVENT_STREAM_USER=noema:events:user-service

# Concept-state stability projection thresholds
CONCEPT_STATE_S_RET=21
CONCEPT_STATE_R_REAS=0.6
CONCEPT_STATE_REASONING_WINDOW=10
CONCEPT_STATE_RECOMPUTE_ENABLED=true
CONCEPT_STATE_RECOMPUTE_INTERVAL_MS=900000
CONCEPT_STATE_RECOMPUTE_BATCH_SIZE=100
CONCEPT_STATE_RECOMPUTE_STALE_AFTER_MS=86400000
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file containing real credentials
# =============================================================================

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# PostgreSQL - Primary Database
# -----------------------------------------------------------------------------
# Each service has its own database following database-per-service pattern
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
POSTGRES_USER=noema
POSTGRES_PASSWORD=noema_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=noema

# Service-specific database URLs
DATABASE_URL_USER=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_user
DATABASE_URL_CONTENT=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_content
DATABASE_URL_SCHEDULER=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_scheduler
DATABASE_URL_SESSION=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_session
DATABASE_URL_GAMIFICATION=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_gamification
DATABASE_URL_KNOWLEDGE_GRAPH=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_knowledge_graph
DATABASE_URL_METACOGNITION=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_metacognition
DATABASE_URL_CURRICULUM=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_curriculum
DATABASE_URL_PEDAGOGY_GUARDIAN=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_pedagogy_guardian
DATABASE_URL_STRATEGY=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_strategy
DATABASE_URL_INGESTION=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_ingestion
DATABASE_URL_ANALYTICS=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_analytics
DATABASE_URL_SYNC=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_sync
DATABASE_URL_NOTIFICATION=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_notification
DATABASE_URL_MEDIA=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_media
DATABASE_URL_COLLABORATION=postgresql://noema:noema_dev_password@127.0.0.1:5432/noema_collaboration

# -----------------------------------------------------------------------------
# Redis - Cache, Sessions, Event Bus
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Qdrant - Vector Database
# -----------------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
VECTOR_SERVICE_URL=http://127.0.0.1:3012
INGESTION_SERVICE_URL=http://127.0.0.1:3009
KNOWLEDGE_GRAPH_SERVICE_URL=http://127.0.0.1:3006
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# MinIO - Object Storage (S3-Compatible)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ROOT_USER=noema
MINIO_ROOT_PASSWORD=noema_minio_password
MINIO_USE_SSL=false
MINIO_BUCKET_CONTENT=content
MINIO_BUCKET_MEDIA=media
MINIO_BUCKET_EXPORTS=exports
MINIO_BUCKET_IMPORTS=imports

# -----------------------------------------------------------------------------
# LLM API Keys - AI Services
# -----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google / Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_PROJECT_NAME=projects/your-project-number
GEMINI_PROJECT_ID=your-project-number

# -----------------------------------------------------------------------------
# JWT & Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
# Node.js Services (3000-3099)
PORT_USER_SERVICE=3001
PORT_CONTENT_SERVICE=3002
PORT_SCHEDULER_SERVICE=3003
PORT_SESSION_SERVICE=3004
PORT_GAMIFICATION_SERVICE=3005
PORT_KNOWLEDGE_GRAPH_SERVICE=3006
PORT_METACOGNITION_SERVICE=3007
PORT_STRATEGY_SERVICE=3008
PORT_INGESTION_SERVICE=3009
PORT_ANALYTICS_SERVICE=3010
PORT_PEDAGOGY_GUARDIAN_SERVICE=3016
PORT_SYNC_SERVICE=3011
PORT_VECTOR_SERVICE=3012
PORT_NOTIFICATION_SERVICE=3013
PORT_MEDIA_SERVICE=3014
PORT_COLLABORATION_SERVICE=3015
PORT_CURRICULUM_SERVICE=3017

# Service-to-service auth token (used by agents to call other services)
# Set this to a static dev token that your services accept; services should
# validate it in their auth middleware (see each service's SERVICE_AUTH_TOKEN check)
SERVICE_AUTH_TOKEN=dev-service-token

# Service base URLs (agents use these to reach other services)
SESSION_SERVICE_URL=http://127.0.0.1:3004
CONTENT_SERVICE_URL=http://127.0.0.1:3002
SCHEDULER_SERVICE_URL=http://127.0.0.1:3003
METACOGNITION_SERVICE_URL=http://127.0.0.1:3007
CURRICULUM_SERVICE_URL=http://127.0.0.1:3017
ANALYTICS_SERVICE_URL=http://127.0.0.1:3010
GAMIFICATION_SERVICE_URL=http://127.0.0.1:3005
STRATEGY_SERVICE_URL=http://127.0.0.1:3008

# Python Agents (8000-8099)
PORT_LEARNING_AGENT=8001
PORT_DIAGNOSTIC_AGENT=8002
PORT_STRATEGY_AGENT=8003
PORT_CONTENT_GENERATION_AGENT=8004
CONTENT_CREATOR_AGENT_URL=http://localhost:8011
PORT_INGESTION_AGENT=8005
PORT_KNOWLEDGE_GRAPH_AGENT=8006
PORT_SOCRATIC_TUTOR_AGENT=8007
PORT_CALIBRATION_AGENT=8008
PORT_GOVERNANCE_AGENT=8009
PORT_TAXONOMY_CURATOR_AGENT=8010
AGENTS_URL=http://localhost:8011
NEXT_PUBLIC_AGENTS_URL=http://localhost:8011
AGENTS_ADMIN_DB_PATH=agents/.artifacts/agents-admin.sqlite3

# Python Sidecars (8020-8029)
PORT_HLR_SIDECAR=8020

# -----------------------------------------------------------------------------
# Email / SMTP (Development - use Mailpit)
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@noema.local

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=noema

# Jaeger
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# -----------------------------------------------------------------------------
# Development Tools Ports
# -----------------------------------------------------------------------------
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@noema.local
PGADMIN_PASSWORD=admin
REDIS_COMMANDER_PORT=8081
MINIO_CONSOLE_PORT=9001
MAILPIT_WEB_PORT=8025

# -----------------------------------------------------------------------------
# HLR Sidecar - Half-Life Regression
# -----------------------------------------------------------------------------
HLR_HOST=0.0.0.0
HLR_PORT=8020
HLR_LOG_LEVEL=info
HLR_LEARNING_RATE=0.001
HLR_HL_WEIGHT=0.01
HLR_L2_WEIGHT=0.1
HLR_SIGMA=1.0

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_DEBUG_LOGGING=true
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_PROFILING=false

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
