generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Evaluation {
  id                String   @id @db.VarChar(50)
  stepId            String   @unique @map("step_id") @db.VarChar(50)
  lessonPlanId      String   @map("lesson_plan_id") @db.VarChar(50)
  sessionId         String   @map("session_id") @db.VarChar(50)
  userId            String   @map("user_id") @db.VarChar(50)
  conceptRefs       String[] @map("concept_refs")
  correct           Boolean
  selfRating        String   @map("self_rating") @db.VarChar(50)
  reasoningQuality  Float    @map("reasoning_quality")
  confidenceSignal  Float    @map("confidence_signal")
  combinedScore     Float    @map("combined_score")
  schedulerRating   String   @map("scheduler_rating") @db.VarChar(50)
  trace             Json
  errorType         String?  @map("error_type") @db.VarChar(100)
  misconceptionRef  String?  @map("misconception_ref") @db.VarChar(100)
  recommendedAction String   @map("recommended_action") @db.VarChar(500)
  responseTimeMs    Int?     @map("response_time_ms")
  studyMode         String   @default("knowledge_gaining") @map("study_mode") @db.VarChar(50)
  transformation    String?  @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at")

  triggers          Trigger[]

  @@index([userId, createdAt])
  @@index([lessonPlanId])
  @@index([sessionId])
  @@index([conceptRefs], type: Gin)
  @@map("evaluations")
}

model Trigger {
  id                      String     @id @db.VarChar(50)
  evaluationId            String     @map("evaluation_id") @db.VarChar(50)
  userId                  String     @map("user_id") @db.VarChar(50)
  type                    String     @db.VarChar(50)
  severity                Float
  detectedFrom            String[]   @map("detected_from")
  conceptRefs             String[]   @map("concept_refs")
  stepId                  String     @map("step_id") @db.VarChar(50)
  sessionId               String     @map("session_id") @db.VarChar(50)
  recommendedIntervention String     @map("recommended_intervention") @db.VarChar(100)
  status                  String     @default("open") @db.VarChar(50)
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  evaluation              Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([sessionId])
  @@index([conceptRefs], type: Gin)
  @@map("triggers")
}

model ConceptReasoningAverage {
  id               String   @id @db.VarChar(120)
  userId           String   @map("user_id") @db.VarChar(50)
  conceptId        String   @map("concept_id") @db.VarChar(50)
  studyMode        String   @default("knowledge_gaining") @map("study_mode") @db.VarChar(50)
  average          Float
  sampleCount      Int      @map("sample_count")
  windowSize       Int      @map("window_size")
  latestEvaluation String?  @map("latest_evaluation") @db.VarChar(50)
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, conceptId, studyMode])
  @@map("concept_reasoning_averages")
}
