# =============================================================================
# @noema/scheduler-service Environment Configuration
# =============================================================================

# Service
NODE_ENV=development
SERVICE_NAME=scheduler-service
SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3003

# Database
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/scheduler_db

# Redis / Event Bus
REDIS_URL=redis://127.0.0.1:6379
REDIS_EVENT_STREAM=noema:events:scheduler-service
REDIS_STREAM_MAX_LEN=10000
EVENT_CONSUMERS_ENABLED=true
CONSUMER_STREAM_METACOGNITION_SERVICE=noema:events:metacognition-service
REDIS_CONSUMER_NAME=scheduler-service-1

# CORS (disabled by default — the API gateway handles CORS)
# Set CORS_ENABLED=true only when running without the gateway.
# CORS_ENABLED=false
# CORS_ORIGIN=http://localhost:3000,http://localhost:3100,http://localhost:3004
# CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# Auth middleware (local development)
AUTH_DISABLED=true
JWT_SECRET=dev-secret
JWT_ISSUER=noema.app
JWT_AUDIENCE=noema.app
