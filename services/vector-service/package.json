{
  "name": "@noema/vector-service",
  "version": "0.1.0",
  "description": "Chunk embedding and vector retrieval service for Noema ingestion and RAG workflows",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo",
    "dev": "node ../../scripts/ensure-dev-infra.cjs vector-service && tsx watch --env-file=.env src/index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@noema/contracts": "workspace:*",
    "@noema/types": "workspace:*",
    "@noema/validation": "workspace:*",
    "fastify": "^5.2.0",
    "nanoid": "^5.0.9",
    "pino": "^9.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
